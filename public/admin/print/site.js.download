
$('#form').on("keyup keypress", function (e) {
    var code = e.keyCode || e.which;
    if (code == 13) {
        e.preventDefault();
        return false;
    }
});

function onChangeThemeBegin() {
    $('.btntheme').html(`<span class='spinner-border spinner-border-sm' role='status' aria-hidden='true'></span>`);
}
function onChangeThemeComplete() {
    $('.btntheme').html(`<span class="live-icon">Change Theme</span>`);
}

function onThemeModal(res) {
    if (res.text === 'SessionTimeout') {
        window.location.href = '/Account/Login';
    }
    else {
        $('#theme-modal').html(res);
        $('.theme-modal').modal('show');
    }
}

function onThemeBegin(id) {
    $('#btntheme_' + id).html(`<span class='spinner-border spinner-border-sm' role='status' aria-hidden='true'></span>`);
}

function OnThemeSuccess(res) {
    if (res.response == "Success") {
        $('.theme-modal').modal('hide');
        SuccessPnotification(res);
        window.location.reload();
    }
    else {
        ErrorPnotification(res);
    }
}

