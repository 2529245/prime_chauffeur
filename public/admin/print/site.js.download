function onBegin(id) {
    $('.btn_' + id).html("<span class='spinner-border spinner-border-sm' role='status' aria-hidden='true'></span>");
}
function onComplete(id, html) {
    html = html.replace(/\"/g, "");
    $('.btn_' + id).html("<i class='" + html + "'></i>");
}

