function onRecordEdit(id) {
    $('.btnEdit_' + id).html("<span class='spinner-border spinner-border-sm' role='status' aria-hidden='true'></span>");
    setTimeout(function () {
        $('.btnEdit_' + id).html("<i class='feather icon-edit-2'></i>");
    }, 3000);
}

$('#pnotify-primary').on('click', function () {
    new PNotify({
        title: 'Primary notice', text: 'Check me out! I\'m a notice.', type: 'primary'
    });
});

var stack_bottomright = {
    dir1: 'up',
    dir2: 'left'
};

function SuccessPnotification(req) {
    var notificationArgs = {
        title: 'Success',
        text: req.message,
        type: req.type,
        stack: stack_bottomright,
        addclass: 'stack-bottomright',
        delay: 1000
    };
    new PNotify(notificationArgs);
}

function ErrorPnotification(req) {
    new PNotify({
        title: req.title, text: req.message, type: req.type, stack: stack_bottomright, addclass: 'stack-bottomright'
    });
}

function CustomNotification(title, message, type, delay) {
    new PNotify({
        title: title, text: message, type: type, stack: stack_bottomright, addclass: 'stack-bottomright', delay: delay
    });
}